{
  "name": "walletchat-server",
  "version": "1.0.0",
  "description": "API server and PostgreSQL database for the WalletChat app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --env-file-if-exists=.env.local src/index.ts",
    "start": "node --env-file=.env --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env scripts/migrate.ts",
    "db:seed": "node --env-file=.env scripts/seed.ts",
    "db:reset": "node --env-file=.env scripts/reset.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.84",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
